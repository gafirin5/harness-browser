# Dorado runtime
NODE_ENV=development
PORT=7788
PUBLIC_BASE_URL=http://localhost:7788
# Optional: origin tambahan yang diizinkan untuk request mutasi & WebSocket
# (pisah koma), mis. URL tunnel Cloudflare. PUBLIC_BASE_URL sudah otomatis diizinkan.
# ALLOWED_ORIGINS=https://contoh.trycloudflare.com,https://dorado.example.com
DATA_DIR=./data
# Password awal; dipakai saat database belum punya admin_credentials.
# Setelah login, ganti lewat Setelan > Ganti Password.
ADMIN_PASSWORD=dorado
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
PAIRING_TOKEN_TTL_HOURS=168
COOKIE_SECURE=false
HOST=127.0.0.1

# Optional: extra agent command templates (JSON)
# DORADO_AGENTS=[{"id":"mock","name":"Mock Agent","command":"node","args":["scripts/mock-agent.mjs"]}]
# Optional: daftar root direktori (pisah koma) yang dipindai untuk penemuan repository.
# Kosongkan untuk memakai HOME.
PROJECT_SCAN_ROOTS=
# Optional: token untuk GitHub API (public repo bisa tanpa token)
GITHUB_TOKEN=

# Orchestrator (provider, agent worker, task queue, dispatcher)
APP_TIMEZONE=Asia/Jakarta
# Wajib diganti di production: base64 dari tepat 32 byte.
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AGENT_DISPATCH_TIMEOUT_MS=5000
AGENT_HEALTH_TIMEOUT_MS=5000
HEARTBEAT_INTERVAL_MS=30000
TASK_MAX_DURATION_MS=3600000
# payload = API key provider ikut dikirim ke worker; none = tidak dikirim.
AGENT_KEY_DELIVERY=payload
