# Runtime
NODE_ENV=development
PORT=3001
# Dev (Vite): http://localhost:5173. Produksi: URL publik sebenarnya.
PUBLIC_BASE_URL=http://localhost:5173
APP_TIMEZONE=Asia/Jakarta

# Database
DATABASE_URL=postgres://orca:orca@127.0.0.1:5432/orca

# Security (ganti di produksi)
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
COOKIE_SECURE=false
BCRYPT_COST=10

# Dispatcher
AGENT_DISPATCH_TIMEOUT_MS=5000
AGENT_HEALTH_TIMEOUT_MS=5000
HEARTBEAT_INTERVAL_MS=30000
TASK_MAX_DURATION_MS=3600000
AGENT_KEY_DELIVERY=payload

# Admin seeder (dipakai saat `npm run seed:admin`)
ADMIN_EMAIL=admin@orca.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME="Dimas Admin"

LOG_LEVEL=info
